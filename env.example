# Only needed when running on your own computer.
# On Vercel, the AI Gateway connects automatically (no key needed).
# Create a key in your Vercel dashboard under AI Gateway > API Keys,
# then copy this file to .env.local and paste it below.
AI_GATEWAY_API_KEY=

# Optional: which model the AI coach uses. Any ID from the AI Gateway model list.
# AI_MODEL=anthropic/claude-sonnet-4.6
